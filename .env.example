# ==============================================================================
# Environment Configuration for tau-bench CRM Benchmark & Grader Audit
# ==============================================================================

# Option 1: Local Ollama / vLLM (Free, Local GPU RTX 4060)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama

# Option 2: Groq Free Tier (LPU speed, 30 RPM / 1000 RPD free)
# Recommended for User Simulator (Llama-3.3-70B) or cloud agent runs
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Option 3: OpenRouter Free Tier (25+ free open-weight models with tool support)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default Provider Selection ('local', 'groq', or 'openrouter')
DEFAULT_AGENT_PROVIDER=local
DEFAULT_USER_PROVIDER=groq
